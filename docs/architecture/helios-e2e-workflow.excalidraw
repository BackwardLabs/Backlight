      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "fontSize": 20,
      "fontFamily": 1,
      "fontStyle": "normal",
      "text": "Priority: incident_slug / display_slug -> protocol_name -> project_name -> display_name -> protocol -> project -> report fallback\nTop-level metadata wins over nested raw_signal fields. RCA-inferred vulnerable contract names do not override protocol_name.\nGitHub target: test/{YYYY-MM}/{safeProtocol}/{safeProtocol}.t.sol + README.md",
      "rawText": "Priority: incident_slug / display_slug -> protocol_name -> project_name -> display_name -> protocol -> project -> report fallback\nTop-level metadata wins over nested raw_signal fields. RCA-inferred vulnerable contract names do not override protocol_name.\nGitHub target: test/{YYYY-MM}/{safeProtocol}/{safeProtocol}.t.sol + README.md",
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "Priority: incident_slug / display_slug -> protocol_name -> project_name -> display_name -> protocol -> project -> report fallback\nTop-level metadata wins over nested raw_signal fields. RCA-inferred vulnerable contract names do not override protocol_name.\nGitHub target: test/{YYYY-MM}/{safeProtocol}/{safeProtocol}.t.sol + README.md",
      "lineHeight": 1.25,
      "baseline": 71
    },
