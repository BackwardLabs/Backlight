# Copy to /srv/backlight/env/backlight-mcp-bridge.env, replace placeholders, then chmod 600.
# Do not commit the populated file.

HELIOS_MCP_BRIDGE_LISTEN_ADDR=127.0.0.1:9090
HELIOS_MCP_BRIDGE_DB_PATH=/srv/backlight/data/backlight-mcp-bridge.db
HELIOS_MCP_BRIDGE_TOKEN=replace-with-a-long-random-bridge-token
# Keep false in production. true allows unauthenticated local dev receiver mode.
HELIOS_MCP_BRIDGE_ALLOW_INSECURE=false
