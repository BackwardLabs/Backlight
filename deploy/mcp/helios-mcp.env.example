# Optional env file for MCP clients that support loading environment files.
# Most stdio MCP clients configure these values inline in their client config.
# Do not commit a populated file.

HELIOS_BASE_URL=http://127.0.0.1:8080
HELIOS_API_TOKEN=replace-with-a-read-only-or-operator-token

# Optional only for bridge mode or legacy direct-file mode. Direct API mode
# reads artifacts through Backlight, so users should normally leave these unset.
# HELIOS_OUTPUT_ROOT=/srv/helios/data/outputs
# HELIOS_OUTPUT_BASE=/srv/helios/data/outputs
# Optional tuning. Defaults are 1048576 bytes and 30 seconds.
# HELIOS_MCP_MAX_BYTES=1048576
# HELIOS_MCP_HTTP_TIMEOUT_SECONDS=30
