# Copy to /srv/helios/env/helios.env, replace placeholders, then chmod 600.
# Keep this file short: unset optional Backlight settings use code defaults.

# Backlight core API/runtime.
HELIOS_API_TOKEN=replace-with-a-long-random-token
HELIOS_LISTEN_ADDR=127.0.0.1:8080
HELIOS_DB_PATH=/srv/helios/data/helios.db
HELIOS_OUTPUT_ROOT=/srv/helios/data/outputs
HELIOS_LUMOSKIT_BIN=/home/ubuntu/lumos/lumoskit/bin/lumoskit
HELIOS_MAX_CONCURRENT_LUMOSKIT=2

# Optional: downstream handoff / GitHub publish / operator notifications.
# HELIOS_DOWNSTREAM_WEBHOOK_URLS=http://127.0.0.1:9090/handoff
# HELIOS_DOWNSTREAM_WEBHOOK_BEARER_TOKEN=replace-with-downstream-token
GH_TOKEN=
# TELEGRAM_BOT_TOKEN=replace-with-bot-token
# TELEGRAM_CHAT_ID=replace-with-chat-id

# Optional: Pre-Lumos importer JSON sidecar.
# HELIOS_PRE_LUMOS_ENABLED=false
# HELIOS_PRE_LUMOS_SEED_ROOT=/srv/helios/data/pre-lumos-seed
# UV_CACHE_DIR=/srv/helios/data/uv-cache

# Best-effort pre-LumosKit incident naming. If lookup fails, Backlight falls back to unknown.
HELIOS_INCIDENT_RESOLVER_ENABLED=true
# HELIOS_ETHERSCAN_API_KEY=
# HELIOS_ETHERSCAN_BASE_URL=https://api.etherscan.io/v2/api
# HELIOS_INCIDENT_RPC_URL=
