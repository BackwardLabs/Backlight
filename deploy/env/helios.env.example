# Copy to /srv/helios/env/helios.env, replace placeholders, then chmod 600.
# Do not commit the populated file.

HELIOS_API_TOKEN=replace-with-a-long-random-token
HELIOS_LISTEN_ADDR=127.0.0.1:8080
HELIOS_DB_PATH=/srv/helios/data/helios.db
HELIOS_OUTPUT_ROOT=/srv/helios/data/outputs
HELIOS_LUMOSKIT_BIN=/srv/helios/bin/lumoskit
HELIOS_MAX_CONCURRENT_LUMOSKIT=2
HELIOS_WORKER_POLL_MILLIS=1000
HELIOS_PARTIAL_AUTO_RERUN_MAX_ATTEMPTS=3

# Passed through unchanged to lumoskit. Set the keys your lumoskit build expects.
# Keep lumoskit runtime secrets in this same Helios service env file for systemd.
CEFG_LIVE_RPC_URL=https://replace-with-rpc.example
RPC_URL=https://replace-with-rpc.example
ETH_RPC_URL=https://replace-with-rpc.example
ALCHEMY_API_KEY=
ETHERSCAN_API_KEY=
OPENAI_API_KEY=

# Optional: enables GitHub publish for verified product artifacts.
GITHUB_TOKEN=
GH_TOKEN=
HELIOS_GITHUB_PUBLISH_OWNER=UPside-Lumos-V2
HELIOS_GITHUB_PUBLISH_REPO=Q1-2026
HELIOS_GITHUB_PUBLISH_BRANCH=main

# Optional: enables the Pre-Lumos Agent SDK sidecar for importer-ready JSON.
UV_CACHE_DIR=/srv/helios/data/uv-cache
HELIOS_PRE_LUMOS_ENABLED=false
HELIOS_PRE_LUMOS_SEED_ROOT=
HELIOS_PRE_LUMOS_OPENAI_BASE_URL=http://127.0.0.1:10631/v1
HELIOS_PRE_LUMOS_PYTHON_BIN=scripts/pre_lumos_agent_uv.sh
HELIOS_PRE_LUMOS_AGENT_SCRIPT=scripts/pre_lumos_agent.py
HELIOS_PRE_LUMOS_SKILL_DIR=skills/pre-lumos
HELIOS_PRE_LUMOS_CASE_OUTPUT_ROOT=
HELIOS_PRE_LUMOS_CASE_OUTPUT_ROOTS=
HELIOS_PRE_LUMOS_YEAR=
HELIOS_PRE_LUMOS_MODEL=
HELIOS_PRE_LUMOS_WEB_SEARCH=false

# Comma-separated downstream handoff targets. Empty means handoff is skipped.
HELIOS_DOWNSTREAM_WEBHOOK_URLS=
# Optional Bearer token sent to every downstream webhook target.
HELIOS_DOWNSTREAM_WEBHOOK_BEARER_TOKEN=

# Operator notifications. Set either or both.
OPERATOR_NOTIFY_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
HELIOS_TELEGRAM_API_BASE=

HELIOS_HANDOFF_RETRY_MAX_ATTEMPTS=5
HELIOS_HANDOFF_RETRY_BACKOFF_BASE_SECONDS=2
HELIOS_HANDOFF_RETRY_BACKOFF_MAX_SECONDS=300
HELIOS_NOTIFY_RETRY_MAX_ATTEMPTS=5
HELIOS_NOTIFY_RETRY_BACKOFF_BASE_SECONDS=2
HELIOS_NOTIFY_RETRY_BACKOFF_MAX_SECONDS=300
