# Copy to /srv/helios/env/lumoskit.env, replace placeholders, then chmod 600.
# deploy/vm/sync-git-runtime.sh can symlink this file to
# /srv/helios/src/lumoskit/.env so the committed LumosKit binary loads it from
# its own repo root.

ALCHEMY_API_KEY=replace-with-alchemy-key
ETHERSCAN_API_KEY=
OPENAI_API_KEY=
