# Copy to /srv/backlight/env/lumoskit.env, replace placeholders, then chmod 600.
# deploy/vm/sync-git-runtime.sh can install this file to
# /home/ubuntu/lumos/lumoskit/.env so the LumosKit binary loads it from
# its own repo root.

ALCHEMY_API_KEY=replace-with-alchemy-key
ETHERSCAN_API_KEY=
OPENAI_API_KEY=

# Optional RCA fallback for contracts without verified source.
# Must point to a local BackwardLabs/decompiler_ir checkout containing run.sh.
LUMOSKIT_DECOMPILER_IR_ROOT=
LUMOSKIT_RCA_DECOMPILER_MODE=off
LUMOSKIT_RCA_DECOMPILER_MAX_ADDRESSES=2
LUMOSKIT_RCA_DECOMPILER_TIMEOUT=3600
