# Copy to /srv/backlight/env/backlight.env, replace placeholders, then chmod 600.
# Keep this file short: unset optional Backlight settings use code defaults.

# Backlight core API/runtime.
BACKLIGHT_API_TOKEN=replace-with-a-long-random-token
BACKLIGHT_LISTEN_ADDR=127.0.0.1:8080
BACKLIGHT_DB_PATH=/srv/backlight/data/backlight.db
BACKLIGHT_OUTPUT_ROOT=/srv/backlight/data/outputs
BACKLIGHT_LUMOSKIT_BIN=/home/ubuntu/lumos/lumoskit/bin/lumoskit
BACKLIGHT_MAX_CONCURRENT_LUMOSKIT=2

# Optional: downstream handoff / GitHub publish / operator notifications.
# BACKLIGHT_DOWNSTREAM_WEBHOOK_URLS=http://127.0.0.1:9090/handoff
# BACKLIGHT_DOWNSTREAM_WEBHOOK_BEARER_TOKEN=replace-with-downstream-token
GH_TOKEN=
# TELEGRAM_BOT_TOKEN=replace-with-bot-token
# TELEGRAM_CHAT_ID=replace-with-chat-id
# Optional: inbound Telegram command bot (/signal, /recent, /cancel, /help).
# Reuses TELEGRAM_BOT_TOKEN; long-polls getUpdates (no public ingress needed).
# TELEGRAM_COMMAND_ENABLED=false
# TELEGRAM_ALLOWED_CHAT_IDS=  # comma-separated chat ids; defaults to TELEGRAM_CHAT_ID
# TELEGRAM_COMMAND_POLL_TIMEOUT_SECONDS=30

# Optional: X publishing for verified incident posts. Keep dry-run true until
# the posting account and template output are reviewed.
# X_PUBLISH_ENABLED=false
# X_CLIENT_ID=replace-with-x-client-id
# X_CLIENT_SECRET=replace-with-x-client-secret
# X_REFRESH_TOKEN=replace-with-x-refresh-token
# X_REFRESH_TOKEN_FILE=/srv/backlight/data/x_refresh_token.json
# X_POST_TEMPLATE_PATH=/srv/backlight/env/x_verified_incident.md
# X_ACCOUNT_USERNAME=BackwardLabs
# X_DRY_RUN=true
# BACKLIGHT_X_FEED_ENABLED=false
# BACKLIGHT_X_FEED_SKILL_DIR=skills/x-feed
# BACKLIGHT_X_FEED_CARD_ENABLED=true
# BACKLIGHT_X_FEED_CARD_PYTHON_BIN=python3
# BACKLIGHT_X_FEED_CARD_TIMEOUT_SECONDS=20
# BACKLIGHT_VICTIM_MENTION=true
# Optional: verify every candidate protocol account through X MCP before adding
# an @mention. Existing X_CLIENT_ID/X_CLIENT_SECRET and refresh-token settings
# enable both exact lookup and user search through hosted MCP.
# BACKLIGHT_X_MCP_ENABLED=false
# BACKLIGHT_X_MCP_URL=https://api.x.com/mcp
# Optional fallback: app-only auth supports exact lookup but not search_users.
# BACKLIGHT_X_MCP_BEARER_TOKEN=replace-with-app-only-bearer-token
# With neither user OAuth nor an app Bearer, Backlight uses the xurl bridge.
# BACKLIGHT_X_MCP_COMMAND=xurl
# BACKLIGHT_X_MCP_ARGS=mcp https://api.x.com/mcp
# BACKLIGHT_X_MCP_TIMEOUT_SECONDS=20
# BACKLIGHT_X_MENTION_CACHE_MAX_AGE_HOURS=168
# BACKLIGHT_X_MENTION_REVERIFY_HOURS=24
# TELEGRAM_PUBLISH_ENABLED=false

# Optional: internal ECW export endpoint. Leave token unset to disable.
# BACKLIGHT_ECW_EXPORT_TOKEN=replace-with-a-separate-long-random-token
# BACKLIGHT_ECW_EXPORT_MAX_BYTES=16777216

# Optional: Pre-Lumos importer JSON sidecar.
# BACKLIGHT_PRE_LUMOS_ENABLED=false
# BACKLIGHT_PRE_LUMOS_SEED_ROOT=/srv/backlight/data/pre-lumos-seed
# BACKLIGHT_PRE_LUMOS_CODEX_BIN=/usr/local/bin/codex
# UV_CACHE_DIR=/srv/backlight/data/uv-cache

# Best-effort pre-LumosKit incident naming. If lookup fails, Backlight falls back to unknown.
BACKLIGHT_INCIDENT_RESOLVER_ENABLED=true
# BACKLIGHT_ETHERSCAN_API_KEY=
# BACKLIGHT_ETHERSCAN_BASE_URL=https://api.etherscan.io/v2/api
# BACKLIGHT_INCIDENT_RPC_URL=
