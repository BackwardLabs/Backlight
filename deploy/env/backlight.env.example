# Copy to /srv/backlight/env/backlight.env, replace placeholders, then chmod 600.
# Keep this file short: unset optional Backlight settings use code defaults.

# Backlight core API/runtime.
HELIOS_API_TOKEN=replace-with-a-long-random-token
HELIOS_LISTEN_ADDR=127.0.0.1:8080
HELIOS_DB_PATH=/srv/backlight/data/backlight.db
HELIOS_OUTPUT_ROOT=/srv/backlight/data/outputs
HELIOS_LUMOSKIT_BIN=/home/ubuntu/lumos/lumoskit/bin/lumoskit
HELIOS_MAX_CONCURRENT_LUMOSKIT=2

# Optional: downstream handoff / GitHub publish / operator notifications.
# HELIOS_DOWNSTREAM_WEBHOOK_URLS=http://127.0.0.1:9090/handoff
# HELIOS_DOWNSTREAM_WEBHOOK_BEARER_TOKEN=replace-with-downstream-token
GH_TOKEN=
# TELEGRAM_BOT_TOKEN=replace-with-bot-token
# TELEGRAM_CHAT_ID=replace-with-chat-id

# Optional: X publishing for verified incident posts. Keep dry-run true until
# the posting account and template output are reviewed.
# X_PUBLISH_ENABLED=false
# X_CLIENT_ID=replace-with-x-client-id
# X_CLIENT_SECRET=replace-with-x-client-secret
# X_REFRESH_TOKEN=replace-with-x-refresh-token
# X_REFRESH_TOKEN_FILE=/srv/backlight/data/x_refresh_token.json
# X_POST_TEMPLATE_PATH=/srv/backlight/env/x_verified_incident.md
# X_ACCOUNT_USERNAME=BackwardLabs
# X_DRY_RUN=true
# HELIOS_X_FEED_ENABLED=false
# HELIOS_X_FEED_SKILL_DIR=skills/x-feed
# HELIOS_X_FEED_INCLUDE_ATTACKER_CA=false
# TELEGRAM_PUBLISH_ENABLED=false

# Optional: internal ECW export endpoint. Leave token unset to disable.
# HELIOS_ECW_EXPORT_TOKEN=replace-with-a-separate-long-random-token
# HELIOS_ECW_EXPORT_MAX_BYTES=16777216

# Optional: Pre-Lumos importer JSON sidecar.
# HELIOS_PRE_LUMOS_ENABLED=false
# HELIOS_PRE_LUMOS_SEED_ROOT=/srv/backlight/data/pre-lumos-seed
# UV_CACHE_DIR=/srv/backlight/data/uv-cache

# Best-effort pre-LumosKit incident naming. If lookup fails, Backlight falls back to unknown.
HELIOS_INCIDENT_RESOLVER_ENABLED=true
# HELIOS_ETHERSCAN_API_KEY=
# HELIOS_ETHERSCAN_BASE_URL=https://api.etherscan.io/v2/api
# HELIOS_INCIDENT_RPC_URL=
