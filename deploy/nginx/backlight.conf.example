# Example production Nginx reverse proxy for Backlight.
#
# Public host split:
#   dashboard.backwardlabs.io -> browser UI and the case API used by that UI
#   api.backwardlabs.io       -> detector ingest, metrics, MCP, and API clients
#
# Install after the backlight-backwardlabs certificate exists:
#   sudo cp deploy/nginx/backlight.conf.example /etc/nginx/sites-available/backlight.conf
#   sudo ln -s /etc/nginx/sites-available/backlight.conf /etc/nginx/sites-enabled/backlight.conf
#   sudo nginx -t && sudo systemctl reload nginx
#
# For first certificate issuance, use deploy/nginx/backlight-bootstrap.conf.example.
#
# Keep Backlight itself bound to 127.0.0.1:8080 and the MCP HTTP endpoint bound
# to 127.0.0.1:8090.

upstream backlight_backend {
    server 127.0.0.1:8080;
    keepalive 16;
}

upstream backlight_mcp_backend {
    server 127.0.0.1:8090;
    keepalive 8;
}

server {
    listen 80;
    listen [::]:80;
    server_name dashboard.backwardlabs.io api.backwardlabs.io;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name dashboard.backwardlabs.io;

    ssl_certificate /etc/letsencrypt/live/backlight-backwardlabs/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/backlight-backwardlabs/privkey.pem;

    client_max_body_size 2m;
    proxy_http_version 1.1;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
    proxy_connect_timeout 10s;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Frame-Options "DENY" always;

    # Optional browser-shell gate. API calls still require BACKLIGHT_API_TOKEN.
    # auth_basic "Backlight Dashboard";
    # auth_basic_user_file /etc/nginx/backlight-dashboard.htpasswd;

    location = / {
        return 302 /ui;
    }

    location = /ui {
        proxy_pass http://backlight_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Authorization $http_authorization;
    }

    # The UI calls /cases and /cases/{case_id}/artifacts with relative URLs.
    location ^~ /cases {
        proxy_pass http://backlight_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Authorization $http_authorization;
    }

    location = /healthz {
        access_log off;
        proxy_pass http://backlight_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    # Do not expose /signals, /metrics, or /mcp from the dashboard host.
    location / {
        return 404;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name api.backwardlabs.io;

    ssl_certificate /etc/letsencrypt/live/backlight-backwardlabs/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/backlight-backwardlabs/privkey.pem;

    client_max_body_size 2m;
    proxy_http_version 1.1;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
    proxy_connect_timeout 10s;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Frame-Options "DENY" always;

    location = /healthz {
        access_log off;
        proxy_pass http://backlight_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location = /signals {
        proxy_pass http://backlight_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Authorization $http_authorization;
    }

    location ^~ /cases {
        proxy_pass http://backlight_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Authorization $http_authorization;
    }

    location = /metrics {
        proxy_pass http://backlight_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Authorization $http_authorization;
    }

    location ^~ /ecw {
        proxy_pass http://backlight_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Authorization $http_authorization;
    }

    location ^~ /mcp {
        proxy_pass http://backlight_mcp_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Authorization $http_authorization;

        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # Keep the API host narrow. The browser dashboard is on dashboard.backwardlabs.io.
    location / {
        return 404;
    }
}
